# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
.pnpm-store/

# ---------------------------------------------------------------------------
# Build outputs
# ---------------------------------------------------------------------------
dist/
dist-electron/
out/
build/

# ---------------------------------------------------------------------------
# Test / coverage artefacts
# Coverage output was previously committed (63 files, recommitted 12+ times).
# It also embeds absolute paths containing the local username.
# ---------------------------------------------------------------------------
coverage/
*.lcov

# ---------------------------------------------------------------------------
# Local databases, SQLite side-files and logs
#
# The bare "-wal" / "-shm" entries are deliberate: the Windows notification
# poller has produced files literally named "-wal" (no basename), which the
# "*.db" rules below do NOT match.
# ---------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.log
-wal
-shm
*.db-wal
*.db-shm
*-journal

# ---------------------------------------------------------------------------
# Secrets and signing material
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pfx
*.p12
*.pem
*.cer
*.key

# ---------------------------------------------------------------------------
# IDE and OS files
# ---------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.suo
*.user

# macOS archive residue (1,511 such files were previously tracked under
# Animations/, 1,504 of them stored in Git LFS).
__MACOSX/
._*

# ---------------------------------------------------------------------------
# Python bytecode (the animation toolchain ships .py helpers)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]

# ---------------------------------------------------------------------------
# Unity metadata & generated files
# ---------------------------------------------------------------------------
/[Aa]ssets/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Llo]gs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/

# ---------------------------------------------------------------------------
# Compiled test outputs
# ---------------------------------------------------------------------------
packages/desktop-app/tests/*.js
packages/desktop-app/tests/*.js.map

# ---------------------------------------------------------------------------
# Vendored upstream firmware reference -- NOT part of this repository.
# Clone https://github.com/busy-app/busybar-firmware separately if needed.
# ---------------------------------------------------------------------------
Documentation/busybar-firmware/

# ---------------------------------------------------------------------------
# Third-party logos and stock icons used only as local input to
# scripts/convert-icons-pixelit.js. The generated 16x16 arrays in
# pixel-bitmaps.ts are committed; these sources are not redistributable.
# See "icon reference/README.md".
icon reference/Slack_icon_2019.png
icon reference/Gmail_icon_(2020).png
icon reference/discord-color-icon.png
icon reference/unity-game-engine-icon.png
icon reference/openproject_icon.png
icon reference/orange-error-icon-0.png
icon reference/pause-button-red-icon.png

# Allow tracking app icons in the desktop-app build directory.
# These negations MUST stay last and in this order: they re-include the one
# directory excluded by the "build/" rule above.
# ---------------------------------------------------------------------------
!packages/desktop-app/build/
!packages/desktop-app/build/*
