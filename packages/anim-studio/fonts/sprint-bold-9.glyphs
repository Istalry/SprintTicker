// Sprint Bold 9: the one-line title face for the animation studio.
//
// Capitals only, 9px tall with 2px stems and 1px bars -- the proportions of
// the single-word titles in the BUSY Bar's own animations (STYLE-GUIDE.md
// §2, §4). Sprint Bold 7 is its two-line companion. Lowercase text is drawn
// in capitals.
//
// Never drawn by the app itself. Same drawing rules as the other sheets,
// enforced by tools/glyphs-to-ts.js.

name: Sprint Bold 9
charset: display
ascent: 9
descent: 0
letterSpacing: 1

