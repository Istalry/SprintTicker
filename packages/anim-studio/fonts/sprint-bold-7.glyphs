// Sprint Bold 7: the display face for scene titles in the animation studio.
//
// Capitals only, 7px tall with 2px strokes, in the manner of the large text
// in the BUSY Bar's own animations. One line centres in the 16px panel, or two
// lines stack at y=0 and y=8. Lowercase text is drawn in capitals.
//
// Never drawn by the app itself; the front display rows use Sprint 5 and
// Sprint Small. Same drawing rules as those sheets, enforced by
// tools/glyphs-to-ts.js.

name: Sprint Bold 7
charset: display
ascent: 7
descent: 0
letterSpacing: 1

