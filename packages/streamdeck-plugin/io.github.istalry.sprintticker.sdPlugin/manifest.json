{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "io.github.istalry.sprintticker",
  "Name": "SprintTicker",
  "Version": "0.6.1.0",
  "Author": "Istalry",
  "Description": "Keys that drive SprintTicker's running session: pause, pick a task, go back to the previous one, start an interruption and go back from it, end the session, and answer the stand-up and the wrap-up. Needs SprintTicker running on the same machine.",
  "URL": "https://github.com/Istalry/SprintTicker",
  "Icon": "imgs/plugin",
  "Category": "SprintTicker",
  "CategoryIcon": "imgs/category",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "24"
  },
  "Profiles": [
    {
      "Name": "profiles/SprintTicker-Mini",
      "DeviceType": 1,
      "DontAutoSwitchWhenInstalled": true,
      "Readonly": false
    }
  ],
  "Actions": [
    {
      "UUID": "io.github.istalry.sprintticker.session",
      "Name": "Session",
      "Tooltip": "The running task and its time. A press pauses or resumes it, or opens the task picker when nothing runs or an interruption does; held, it opens the task picker. Amber when nothing is timing in your working hours.",
      "Icon": "imgs/actions/session",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/session",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "io.github.istalry.sprintticker.interrupt",
      "Name": "Interrupt",
      "Tooltip": "Starts a timer at once, whatever runs: the task it stops waits, paused. During an interruption it is Another. Counts the interruptions waiting to be placed.",
      "Icon": "imgs/actions/interrupt",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/interrupt",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "io.github.istalry.sprintticker.previous",
      "Name": "Previous task",
      "Tooltip": "Goes back to the task you timed before this one, in one press. Blank during an interruption, where Answer A goes back.",
      "Icon": "imgs/actions/previous",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/previous",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "io.github.istalry.sprintticker.answer-a",
      "Name": "Answer A",
      "Tooltip": "Says yes: Done (two presses), Back to the task during an interruption, Join the stand-up, Resume, End stand-up. Blank when there is nothing to say yes to.",
      "Icon": "imgs/actions/answer-a",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/answer-a",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "io.github.istalry.sprintticker.answer-b",
      "Name": "Answer B",
      "Tooltip": "Stops or waits, keeping the time: Stop, which logs the session and leaves the task open; Skip; Not now.",
      "Icon": "imgs/actions/answer-b",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/answer-b",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "io.github.istalry.sprintticker.answer-c",
      "Name": "Answer C",
      "Tooltip": "Throws away: Discard, or Discard ⚡ during an interruption, always two presses. Blank when there is nothing to throw away.",
      "Icon": "imgs/actions/answer-c",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/answer-c",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "io.github.istalry.sprintticker.recent-1",
      "Name": "Recent 1",
      "Tooltip": "Starts your most recent task, as the picker lists them; never the one running. Blank until you have one.",
      "Icon": "imgs/actions/recent-1",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/recent-1",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "io.github.istalry.sprintticker.recent-2",
      "Name": "Recent 2",
      "Tooltip": "Starts your second most recent task, as the picker lists them; never the one running. Blank until you have one.",
      "Icon": "imgs/actions/recent-2",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/recent-2",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "io.github.istalry.sprintticker.recent-3",
      "Name": "Recent 3",
      "Tooltip": "Starts your third most recent task, as the picker lists them; never the one running. Blank until you have one.",
      "Icon": "imgs/actions/recent-3",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/recent-3",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "io.github.istalry.sprintticker.not-done",
      "Name": "Not done",
      "Tooltip": "Stop: ends the session and logs its time; the task stays open.",
      "Icon": "imgs/actions/not-done",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/not-done",
          "ShowTitle": false
        }
      ],
      "VisibleInActionsList": false
    },
    {
      "UUID": "io.github.istalry.sprintticker.done",
      "Name": "Done",
      "Tooltip": "Ends the session and marks the task done. Always two presses, on the same key.",
      "Icon": "imgs/actions/done",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/done",
          "ShowTitle": false
        }
      ],
      "VisibleInActionsList": false
    },
    {
      "UUID": "io.github.istalry.sprintticker.discard",
      "Name": "Discard",
      "Tooltip": "Throws the session away: nothing logged, nothing sent. Always asks first, on the same key.",
      "Icon": "imgs/actions/discard",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/discard",
          "ShowTitle": false
        }
      ],
      "VisibleInActionsList": false
    },
    {
      "UUID": "io.github.istalry.sprintticker.yes",
      "Name": "Yes",
      "Tooltip": "Yes to what SprintTicker is asking: join the stand-up, wrap up the day, resume a task. Dimmed when nothing is asked.",
      "Icon": "imgs/actions/yes",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/yes",
          "ShowTitle": false
        }
      ],
      "VisibleInActionsList": false
    },
    {
      "UUID": "io.github.istalry.sprintticker.no",
      "Name": "No",
      "Tooltip": "No to what SprintTicker is asking. Dimmed when nothing is asked.",
      "Icon": "imgs/actions/no",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/no",
          "ShowTitle": false
        }
      ],
      "VisibleInActionsList": false
    }
  ]
}