{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "io.github.istalry.sprintticker",
  "Name": "SprintTicker",
  "Version": "0.1.0.0",
  "Author": "Istalry",
  "Description": "Keys that drive SprintTicker's running session: pause, end, switch task, start a favourite, and answer the stand-up and the wrap-up. Needs SprintTicker running on the same machine.",
  "URL": "https://github.com/Istalry/SprintTicker",
  "Icon": "imgs/plugin",
  "Category": "SprintTicker",
  "CategoryIcon": "imgs/category",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "24"
  },
  "Actions": [
    {
      "UUID": "io.github.istalry.sprintticker.session",
      "Name": "Session",
      "Tooltip": "The running task and its time. Pauses it, resumes it, or opens the task picker when nothing runs.",
      "Icon": "imgs/actions/session",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/session",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "io.github.istalry.sprintticker.not-done",
      "Name": "Not done",
      "Tooltip": "Ends the session and logs its time; the task stays open.",
      "Icon": "imgs/actions/not-done",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/not-done",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "io.github.istalry.sprintticker.done",
      "Name": "Done",
      "Tooltip": "Ends the session and marks the task done. Asks first, on the same key, when the task is no longer yours.",
      "Icon": "imgs/actions/done",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/done",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "io.github.istalry.sprintticker.discard",
      "Name": "Discard",
      "Tooltip": "Throws the session away: nothing logged, nothing sent. Always asks first, on the same key.",
      "Icon": "imgs/actions/discard",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/discard",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "io.github.istalry.sprintticker.switch",
      "Name": "Switch task",
      "Tooltip": "Brings SprintTicker forward with its task picker open.",
      "Icon": "imgs/actions/switch",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/switch",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "io.github.istalry.sprintticker.favourite",
      "Name": "Favourite task",
      "Tooltip": "Starts the task you choose for this key.",
      "Icon": "imgs/actions/favourite",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/favourite.html",
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/favourite",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "io.github.istalry.sprintticker.yes",
      "Name": "Yes",
      "Tooltip": "Yes to what SprintTicker is asking: join the stand-up, wrap up the day, resume a task. Dimmed when nothing is asked.",
      "Icon": "imgs/actions/yes",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/yes",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "io.github.istalry.sprintticker.no",
      "Name": "No",
      "Tooltip": "No to what SprintTicker is asking. Dimmed when nothing is asked.",
      "Icon": "imgs/actions/no",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/no",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "io.github.istalry.sprintticker.away",
      "Name": "Away",
      "Tooltip": "Sets you away, and back.",
      "Icon": "imgs/actions/away",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/away",
          "ShowTitle": false
        }
      ]
    }
  ]
}