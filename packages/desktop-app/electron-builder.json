{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.antigravity.busybar",
  "productName": "Antigravity BUSY Bar Companion",
  "copyright": "Copyright © 2026 jbgeron. MIT. Animations © Flipper FZCO, CC-BY-SA-4.0.",
  "directories": {
    "output": "dist-electron",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "build/**/*",
    "package.json"
  ],
  "extraFiles": [
    {
      "from": "../unity-plugin",
      "to": "packages/unity-plugin",
      "filter": ["**/*", "!**/node_modules/**", "!**/.git/**"]
    }
  ],
  "extraResources": [
    {
      "from": "../../Animations",
      "to": "Animations",
      "filter": ["**/*", "!**/__MACOSX/**", "!**/._*"]
    },
    {
      "from": "../../LICENSE",
      "to": "LICENSE"
    }
  ],
  "npmRebuild": true,
  "asar": true,
  "win": {
    "icon": "build/icon.png",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
