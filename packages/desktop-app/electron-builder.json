{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "io.github.istalry.sprintticker",
  "productName": "SprintTicker",
  "copyright": "Copyright © 2026 jbgeron. MIT.",
  "directories": {
    "output": "dist-electron",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "!dist/**/*.map",
    "!**/node_modules/better-sqlite3/deps/**",
    "!**/node_modules/better-sqlite3/src/**",
    "!**/node_modules/better-sqlite3/build/**",
    "!**/node_modules/better-sqlite3/prebuilds/{darwin,linux,linuxmusl}-*.node",
    "!**/node_modules/node-addon-api/**",
    "build/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "../../Animations",
      "to": "Animations",
      "filter": ["**/*", "!**/__MACOSX/**", "!**/._*"]
    },
    {
      "from": "../../LICENSE",
      "to": "LICENSE"
    },
    {
      "from": "../streamdeck-plugin/dist/io.github.istalry.sprintticker.streamDeckPlugin",
      "to": "StreamDeck/SprintTicker.streamDeckPlugin"
    },
    {
      "from": "../agent-cli/dist/sprintticker.mjs",
      "to": "agent/sprintticker.mjs"
    },
    {
      "from": "../agent-cli/launcher/sprintticker.cmd",
      "to": "agent/sprintticker.cmd"
    }
  ],
  "electronLanguages": ["en-US"],
  "npmRebuild": false,
  "asar": true,
  "publish": [
    {
      "provider": "github",
      "owner": "Istalry",
      "repo": "SprintTicker",
      "releaseType": "draft"
    }
  ],
  "win": {
    "icon": "build/icon.png",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "portable": {
    "artifactName": "${productName}-${version}-${os}-${arch}-portable.${ext}"
  },
  "nsis": {
    "artifactName": "${productName}-${version}-${os}-${arch}-setup.${ext}",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "differentialPackage": false
  }
}
