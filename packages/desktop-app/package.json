{
  "name": "@sprintticker/desktop-app",
  "productName": "SprintTicker",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "description": "SprintTicker desktop application",
  "author": "jbgeron",
  "main": "dist/main/index.js",
  "browserslist": [
    "electron 44.0"
  ],
  "scripts": {
    "dev:renderer": "vite",
    "dev:preload": "vite build --config vite.config.preload.ts --watch",
    "dev:main": "vite build --config vite.config.electron.ts --watch",
    "dev:electron": "wait-on http://localhost:3000 && wait-on dist/main/index.js && wait-on dist/preload/index.js && cross-env VITE_DEV_SERVER_URL=http://localhost:3000 electron .",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:preload\" \"npm:dev:main\" \"npm:dev:electron\"",
    "clean:dist": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean:dist && vite build --config vite.config.electron.ts && vite build --config vite.config.preload.ts && vite build",
    "package:win": "pnpm run build && electron-builder --win",
    "package:portable": "pnpm run build && electron-builder --win portable",
    "package:installer": "pnpm run build && electron-builder --win nsis",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev:mock": "cross-env MOCK_HARDWARE=true pnpm dev",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.renderer-tests.json"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.1",
    "lucide-react": "^1.48.0",
    "postcss": "^8.4.38",
    "prebuild-install": "^7.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "wait-on": "^9.1.0"
  }
}
