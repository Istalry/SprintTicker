{
  "name": "@busy-app/desktop-app",
  "version": "1.0.0",
  "private": true,
  "description": "Antigravity BUSY Bar Electron Desktop Companion App",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "package:win": "tsc && vite build && electron-builder --win",
    "package:portable": "tsc && vite build && electron-builder --win portable",
    "package:installer": "tsc && vite build && electron-builder --win nsis",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@busy-app/busy-lib": "^0.17.0",
    "better-sqlite3": "^11.0.0",
    "fastify": "^4.26.0",
    "lucide-react": "^0.359.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.6.1",
    "autoprefixer": "^10.4.19",
    "electron": "^30.0.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.0",
    "vite": "^5.1.6",
    "vitest": "^1.4.0"
  }
}
