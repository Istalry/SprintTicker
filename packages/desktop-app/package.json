{
  "name": "@sprintticker/desktop-app",
  "productName": "SprintTicker",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "SprintTicker desktop application",
  "author": "jbgeron",
  "main": "dist/main/index.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:preload": "vite build --config vite.config.preload.ts --watch",
    "dev:main": "vite build --config vite.config.electron.ts --watch",
    "dev:electron": "wait-on http://localhost:3000 && wait-on dist/main/index.js && wait-on dist/preload/index.js && cross-env VITE_DEV_SERVER_URL=http://localhost:3000 electron .",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:preload\" \"npm:dev:main\" \"npm:dev:electron\"",
    "build": "vite build --config vite.config.electron.ts && vite build --config vite.config.preload.ts && vite build",
    "package:win": "vite build --config vite.config.electron.ts && vite build --config vite.config.preload.ts && vite build && electron-builder --win",
    "package:portable": "vite build --config vite.config.electron.ts && vite build --config vite.config.preload.ts && vite build && electron-builder --win portable",
    "package:installer": "vite build --config vite.config.electron.ts && vite build --config vite.config.preload.ts && vite build && electron-builder --win nsis",
    "predev": "pnpm rebuild:electron",
    "pretest": "pnpm rebuild better-sqlite3",
    "pretest:coverage": "pnpm rebuild better-sqlite3",
    "rebuild:electron": "electron-builder install-app-deps",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev:mock": "cross-env MOCK_HARDWARE=true pnpm dev",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.renderer.json"
  },
  "dependencies": {
    "@busy-app/busy-lib": "^0.17.0",
    "better-sqlite3": "^11.0.0",
    "bindings": "^1.5.0",
    "file-uri-to-path": "^1.0.0",
    "lucide-react": "^0.359.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/node": "^24.13.3",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^30.0.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.38",
    "prebuild-install": "^7.1.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wait-on": "^9.1.0"
  }
}
