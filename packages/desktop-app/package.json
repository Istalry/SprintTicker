{
  "name": "@busy-app/desktop-app",
  "version": "1.0.0",
  "private": true,
  "description": "Antigravity BUSY Bar Electron Desktop Companion App",
  "author": "Antigravity",
  "main": "dist/main/index.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:main": "vite build --config vite.config.electron.ts --watch",
    "dev:electron": "wait-on http://localhost:3000 && cross-env VITE_DEV_SERVER_URL=http://localhost:3000 electron .",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "build": "vite build --config vite.config.electron.ts && vite build",
    "package:win": "vite build --config vite.config.electron.ts && vite build && electron-builder --win",
    "package:portable": "vite build --config vite.config.electron.ts && vite build && electron-builder --win portable",
    "package:installer": "vite build --config vite.config.electron.ts && vite build && electron-builder --win nsis",
    "pretest": "pnpm rebuild better-sqlite3",
    "pretest:coverage": "pnpm rebuild better-sqlite3",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "bundledDependencies": [
    "fastify",
    "avvio",
    "find-my-way",
    "light-my-request",
    "pino",
    "pino-std-serializers",
    "@fastify/ajv-compiler",
    "@fastify/error",
    "@fastify/fast-json-stringify-compiler",
    "ajv",
    "fast-json-stringify",
    "fast-deep-equal",
    "fast-uri",
    "flatstr",
    "process-warning",
    "rfdc",
    "secure-json-parse",
    "better-sqlite3"
  ],
  "dependencies": {
    "@busy-app/busy-lib": "^0.17.0",
    "better-sqlite3": "^11.0.0",
    "fastify": "^4.26.0",
    "lucide-react": "^0.359.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.6.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "prebuild-install": "^7.1.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.0",
    "vite": "^5.1.6",
    "vitest": "^1.4.0",
    "wait-on": "^9.1.0"
  }
}
