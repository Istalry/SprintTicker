{
  "name": "antigravity-busy-bar-monorepo",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Antigravity BUSY Bar Monorepo containing PC Companion Desktop Application and Unity C# Plugin",
  "scripts": {
    "dev": "pnpm --filter @busy-app/desktop-app dev",
    "build": "pnpm --filter @busy-app/desktop-app build",
    "package:win": "pnpm --filter @busy-app/desktop-app package:win",
    "verify:packed": "node scripts/verify-packed-app.js",
    "preflight": "node scripts/preflight-check.js",
    "test": "pnpm --filter @busy-app/desktop-app test",
    "test:coverage": "pnpm --filter @busy-app/desktop-app test:coverage",
    "editor": "node tools/pixel-editor/server.js",
    "lint": "eslint packages --ext .ts,.tsx",
    "typecheck": "pnpm --filter @busy-app/desktop-app typecheck",
    "format": "prettier --write \"packages/**/*.{ts,tsx,json,css,md}\"",
    "lint:fix": "eslint packages --ext .ts,.tsx --fix",
    "dev:mock": "pnpm --filter @busy-app/desktop-app dev:mock",
    "verify:unity": "node scripts/verify-unity-plugin.js"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
