{
  "name": "sprintticker-monorepo",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "description": "SprintTicker monorepo: the desktop application, its Unity Editor plugin and the animation studio",
  "scripts": {
    "dev": "pnpm --filter @sprintticker/desktop-app dev",
    "build": "pnpm --filter @sprintticker/desktop-app build",
    "package:win": "pnpm --filter @sprintticker/desktop-app package:win",
    "verify:packed": "node scripts/verify-packed-app.js",
    "preflight": "node scripts/preflight-check.js",
    "db:check-migration": "node scripts/db-check-migration.mjs",
    "test": "pnpm --filter @sprintticker/desktop-app test && pnpm --filter @sprintticker/anim-studio test",
    "test:studio": "pnpm --filter @sprintticker/anim-studio test",
    "test:coverage": "pnpm --filter @sprintticker/desktop-app test:coverage",
    "editor": "node tools/pixel-editor/server.js",
    "studio": "pnpm --filter @sprintticker/anim-studio dev",
    "lint": "eslint packages",
    "typecheck": "pnpm --filter @sprintticker/desktop-app typecheck && pnpm --filter @sprintticker/anim-studio typecheck",
    "format": "prettier --write \"packages/**/*.{ts,tsx,json,css,md}\"",
    "lint:fix": "eslint packages --fix",
    "dev:mock": "pnpm --filter @sprintticker/desktop-app dev:mock",
    "mock:openproject": "node scripts/fake-openproject.js",
    "mock:jira": "node scripts/fake-jira.js",
    "probe:jira-worklog": "node scripts/jira-worklog-probe.js",
    "probe:busybar": "node scripts/busybar-probe.js",
    "verify:unity": "node scripts/verify-unity-plugin.js",
    "docs:build": "node scripts/build-docs.js",
    "docs:check": "node scripts/build-docs.js --check",
    "fonts:build": "node tools/glyphs-to-ts.js",
    "fonts:check": "node tools/glyphs-to-ts.js --check",
    "fonts:preview": "node tools/glyphs-to-ts.js --preview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "marked": "^18.0.14",
    "prettier": "^3.2.5",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
